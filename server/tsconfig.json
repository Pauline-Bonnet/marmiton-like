{
  "compilerOptions": {
    // "target": "ES2020",
    // "module": "ES2022",
        "module": "esnext",   // ou "es2022", "node16", "nodenext", etc.
    "target": "es2017",   // ou supérieur, ex: "es2019" ou "es2020"
    "moduleResolution": "node",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "moduleDetection": "force",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
     "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": ["src/**/*"]
}